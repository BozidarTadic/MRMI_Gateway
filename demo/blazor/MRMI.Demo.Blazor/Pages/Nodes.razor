@page "/nodes"
@inject DemoState State
@implements IDisposable

<PageTitle>Nodes</PageTitle>

<div class="nodes-layout">
    <div class="nodes-header">
        <div>
            <h5 class="mb-1">Nodes</h5>
            <div class="text-muted small">Inspect node status, audit log, and DLQ. Use <a href="policy">Policy Playground</a> to run custom scenarios.</div>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LoadNodes" disabled="@_loading">
            @(_loading ? "Loading..." : "Refresh")
        </button>
    </div>

    <!-- ── Live connection status ──────────────────────────────────── -->
    <div class="conn-status-grid">
        @foreach (var cs in ConnectionStates())
        {
            <div class="conn-card @(cs.Online ? "" : "conn-card-offline")">
                <div class="conn-card-head">
                    <span class="node-pill @(cs.Online ? "node-online" : "node-offline")">@cs.Region node</span>
                    @if (!cs.Online && cs.Retrying)
                    {
                        <span class="badge bg-secondary" style="font-size:0.68rem">retrying…</span>
                    }
                    <span class="ms-auto text-muted" style="font-size:0.7rem">
                        @(cs.LastSeen.HasValue
                            ? "seen " + cs.LastSeen.Value.ToLocalTime().ToString("HH:mm:ss")
                            : "not yet seen")
                    </span>
                    <button class="btn btn-sm btn-outline-secondary" style="padding:0.1rem 0.5rem;font-size:0.72rem"
                            @onclick="() => ProbeNode(cs.Region)" disabled="@_probing">
                        @(_probing ? "…" : "Probe")
                    </button>
                </div>
                @if (!cs.Online)
                {
                    <div class="conn-error">@(cs.LastError ?? "Stream disconnected — check the gateway process")</div>
                    <div class="text-muted" style="font-size:0.7rem;margin-top:0.2rem">
                        Reconnect is automatic every 3 s. Use "Probe" to check immediately.
                    </div>
                }
            </div>
        }
    </div>

    <div class="node-grid">
        @foreach (var node in _nodes)
        {
            <div class="node-card">
                <div class="node-card-head">
                    <div>
                        <div class="node-title">@node.Label Node</div>
                        <div class="node-url">@node.BaseUrl</div>
                    </div>
                    <span class="node-pill @(node.Online ? "node-online" : "node-offline")">@(node.Online ? "online" : "offline")</span>
                </div>

                @if (node.Status is not null)
                {
                    <div class="node-facts">
                        <div><span>id</span><strong>@node.Status.NodeId</strong></div>
                        <div><span>region</span><strong>@node.Status.Region</strong></div>
                        <div><span>profile</span><strong>@node.Status.Profile</strong></div>
                        <div><span>law</span><strong>@node.Status.ApplicableLaw</strong></div>
                    </div>
                }
                else
                {
                    <div class="node-error">@node.Error</div>
                }

                <div class="node-actions">
                    <a class="btn btn-sm btn-primary" href="@($"{node.BaseUrl}/ui/")" target="_blank">Open dashboard</a>
                </div>

                <div class="node-section-title">Latest audit</div>
                <div class="node-mini-log">
                    @foreach (var entry in node.Audit.Take(4))
                    {
                        <div class="node-log-row">
                            <span class="badge @(entry.Decision == "ALLOW" ? "bg-success" : entry.Decision == "DENY" ? "bg-danger" : "bg-warning text-dark")">@entry.Decision</span>
                            <span>@entry.SenderRegion → @entry.RecipientRegion</span>
                            <span class="text-muted">@entry.Reason</span>
                        </div>
                    }
                    @if (!node.Audit.Any())
                    {
                        <div class="text-muted small">No audit entries yet.</div>
                    }
                </div>

                <div class="node-section-title">
                    DLQ
                    <button class="btn btn-sm btn-outline-warning ms-2" style="padding:0.05rem 0.4rem;font-size:0.68rem"
                            @onclick="() => CreateDlqEntry(node.Label)" disabled="@(_dlqBusy || _loading)"
                            title="Send RS→BY to an unreachable peer — creates a DLQ entry after forwarding retries">
                        + Create entry
                    </button>
                </div>
                @if (node.Dlq.Count == 0)
                {
                    <div class="text-muted small">No DLQ entries. Use "+ Create entry" to generate one.</div>
                }
                else
                {
                    <div class="node-mini-log">
                        @foreach (var dlq in node.Dlq)
                        {
                            <div class="dlq-row">
                                <span class="badge bg-secondary" style="font-size:0.65rem">#@dlq.Index</span>
                                <span class="text-muted" style="font-size:0.7rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1">@(dlq.LastError ?? dlq.PeerAddr)</span>
                                <button class="btn dlq-btn btn-outline-success" title="Replay"
                                        @onclick="() => ReplayDlq(node.Label, dlq.Index)" disabled="@_dlqBusy">▶</button>
                                <button class="btn dlq-btn btn-outline-danger" title="Discard"
                                        @onclick="() => DiscardDlq(node.Label, dlq.Index)" disabled="@_dlqBusy">✕</button>
                            </div>
                        }
                    </div>
                }
                @if (_dlqFeedback.TryGetValue(node.Label, out var fb))
                {
                    <div class="text-muted small mt-1" style="font-size:0.7rem">@fb</div>
                }
            </div>
        }
    </div>
</div>

@code {
    private record ConnState(string Region, bool Online, bool Retrying, string? LastError, DateTimeOffset? LastSeen);

    private IEnumerable<ConnState> ConnectionStates() =>
    [
        new("RS", State.RsOnline, State.RsRetrying, State.RsLastError, State.RsLastSeen),
        new("RU", State.RuOnline, State.RuRetrying, State.RuLastError, State.RuLastSeen),
    ];

    private IReadOnlyList<NodeSnapshot> _nodes = [];
    private bool _loading;
    private bool _probing;
    private bool _dlqBusy;
    private readonly Dictionary<string, string> _dlqFeedback = new();
    private System.Threading.Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        State.OnChanged += OnStateChanged;
        await LoadNodes();
        _refreshTimer = new System.Threading.Timer(
            async _ => { _nodes = await State.LoadNodeSnapshotsAsync(); await InvokeAsync(StateHasChanged); },
            null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    private async Task LoadNodes()
    {
        _loading = true;
        _nodes = await State.LoadNodeSnapshotsAsync();
        _loading = false;
    }

    private async Task ProbeNode(string region)
    {
        _probing = true;
        await State.ProbeNodeAsync(region);
        _nodes = await State.LoadNodeSnapshotsAsync();
        _probing = false;
    }

    private async Task ReplayDlq(string label, int index)
    {
        _dlqBusy = true;
        var (decision, error) = await State.ReplayDlqEntryAsync(label, index);
        _dlqFeedback[label] = error is not null ? $"Replay failed: {error}" : $"Replayed → {decision}";
        _nodes = await State.LoadNodeSnapshotsAsync();
        _dlqBusy = false;
    }

    private async Task DiscardDlq(string label, int index)
    {
        _dlqBusy = true;
        var error = await State.DiscardDlqEntryAsync(label, index);
        _dlqFeedback[label] = error is not null ? $"Discard failed: {error}" : "Entry discarded.";
        _nodes = await State.LoadNodeSnapshotsAsync();
        _dlqBusy = false;
    }

    private async Task CreateDlqEntry(string label)
    {
        _dlqBusy = true;
        _dlqFeedback[label] = "Sent RS→BY (unreachable peer). DLQ entry appears after forwarding retries — click Refresh in ~60 s.";
        await State.SendDirectAsync(label, "BY", "DLQ demo — forwarding to unreachable BY peer");
        _dlqBusy = false;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        _refreshTimer?.Dispose();
        State.OnChanged -= OnStateChanged;
    }
}
